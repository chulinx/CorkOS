<?xml version="1.0" encoding="utf-8"?>
<!--
  ContentDialog shell.

  The padding values include the card drawable's own margin: both 9-patch cards
  (?attr/contentDialogBackground) carry a ~10dp transparent border around the visible card, so
  "visible gap = padding minus 10dp".  The numbers below are chosen for a ~22dp visible gap on
  every side; if the card drawable is ever replaced with a plain shape, drop 10dp from each.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="34dp"
    android:paddingBottom="30dp"
    android:background="?attr/contentDialogBackground">

    <LinearLayout
        android:id="@+id/LLTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/IVIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="@color/ui_text_muted"
                android:layout_marginRight="8dp"
                android:visibility="gone" />

            <!-- Resolved against the dialog theme (see ContentDialog), so these follow the UI
                 theme instead of the Activity's hardcoded white. -->
            <TextView
                android:id="@+id/TVTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="2dp" />
        </LinearLayout>

        <View style="@style/HorizontalLine" />
    </LinearLayout>

    <TextView
        android:id="@+id/TVMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <EditText
        style="@style/EditText"
        android:id="@+id/EditText"
        android:layout_width="280dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <ListView
        android:id="@+id/ListView"
        android:layout_width="340dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/FrameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/LLBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View style="@style/HorizontalLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="right">

            <TextView
                android:id="@+id/TVBottomBarText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/LLBottomBarPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@id/BTReset"
                    android:visibility="gone"
                    android:text="@string/reset"
                    style="@style/ContentDialogButton" />

                <Button
                    style="@style/ContentDialogButton"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/cancel"
                    android:id="@+id/BTCancel" />

                <Button
                    style="@style/ContentDialogButton.Confirm"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/ok"
                    android:id="@+id/BTConfirm" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
