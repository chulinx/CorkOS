<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/IngameSidebarRail"
    android:layout_width="58dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/sidebar_rail_bg"
    android:elevation="14dp"
    android:translationZ="14dp">

    <com.winlator.cmod.ui.SidebarNavItemView
        android:id="@+id/BTItemGraphics"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/sidebar_nav_icon_bg">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_sidebar_gpu"
            app:tint="@color/ingame_sidebar_icon_tint" />
    </com.winlator.cmod.ui.SidebarNavItemView>

    <com.winlator.cmod.ui.SidebarNavItemView
        android:id="@+id/BTItemScreen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/sidebar_nav_icon_bg">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_sidebar_effects"
            app:tint="@color/ingame_sidebar_icon_tint" />
    </com.winlator.cmod.ui.SidebarNavItemView>

    <com.winlator.cmod.ui.SidebarNavItemView
        android:id="@+id/BTItemInput"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/sidebar_nav_icon_bg">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:duplicateParentState="true"
            android:src="@drawable/icon_mouse"
            app:tint="@color/ingame_sidebar_icon_tint" />
    </com.winlator.cmod.ui.SidebarNavItemView>

    <com.winlator.cmod.ui.SidebarNavItemView
        android:id="@+id/BTItemFPS"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/sidebar_nav_icon_bg">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_sidebar_performance"
            app:tint="@color/ingame_sidebar_icon_tint" />
    </com.winlator.cmod.ui.SidebarNavItemView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/BottomActionGroup"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">
        <com.winlator.cmod.ui.SidebarNavItemView
            android:id="@+id/BTItemTaskManager"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:duplicateParentState="true"
                android:src="@drawable/ic_sidebar_task_manager"
                app:tint="@color/ingame_sidebar_icon_tint" />
        </com.winlator.cmod.ui.SidebarNavItemView>

        <com.winlator.cmod.ui.SidebarNavItemView
            android:id="@+id/BTItemPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:duplicateParentState="true"
                android:src="@drawable/icon_pause"
                app:tint="@color/ingame_sidebar_icon_tint" />
        </com.winlator.cmod.ui.SidebarNavItemView>

        <LinearLayout
            android:id="@+id/BTItemExit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_exit">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_power"
                app:tint="@color/ingame_sidebar_power" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
