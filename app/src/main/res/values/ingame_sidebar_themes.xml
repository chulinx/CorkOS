<?xml version="1.0" encoding="utf-8"?>
<!--
  In-game sidebar palette.

  There is deliberately ONE palette now. Previously there were six (White/Black/Amoled/Blue/Red/
  Purple) and they only overrode colorAccent/colorControlActivated, so Material components
  (Switch, SeekBar) fell back to the app theme's colorPrimary, which on MIUI/HyperOS resolves to
  the wallpaper's dynamic colour; the sidebar therefore picked up an arbitrary accent (a pink one,
  on the test device). Every Material colour role is pinned here so nothing leaks in from outside.

  The palette follows Gaishi's in-game overlay: near-black rail, slightly lighter panel, white
  primary text, grey secondary text, and a single blue accent. The five legacy names are kept as
  aliases so an existing "winlator_ui_theme" preference keeps working and simply renders the same.
-->
<resources>
    <style name="IngameSidebarTheme_Black">
        <item name="ingameSidebarBackground">#141416</item>
        <item name="ingameSidebarSurface">#1E1E20</item>
        <item name="ingameSidebarSurfaceVariant">#2E2E32</item>
        <item name="ingameSidebarOnSurface">#FFFFFF</item>
        <item name="ingameSidebarOnSurfaceVariant">#9A9AA0</item>
        <item name="ingameSidebarPrimary">#3B82F6</item>
        <item name="ingameSidebarPrimaryContainer">#1E3A5F</item>
        <item name="ingameSidebarOutline">#3A3A3E</item>

        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9A9AA0</item>
        <item name="android:textColorHint">#6A6A70</item>
        <item name="android:colorAccent">#3B82F6</item>
        <item name="colorAccent">#3B82F6</item>
        <item name="colorControlNormal">#9A9AA0</item>
        <item name="colorControlActivated">#3B82F6</item>
        <item name="colorControlHighlight">#33FFFFFF</item>

        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryVariant">#1E3A5F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#3B82F6</item>
        <item name="colorSecondaryVariant">#1E3A5F</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:colorBackground">#141416</item>
        <item name="colorSurface">#1E1E20</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorError">#F09595</item>
        <item name="colorOnError">#501313</item>
    </style>

    <style name="IngameSidebarTheme_White"  parent="IngameSidebarTheme_Black" />
    <style name="IngameSidebarTheme_Amoled" parent="IngameSidebarTheme_Black" />
    <style name="IngameSidebarTheme_Blue"   parent="IngameSidebarTheme_Black" />
    <style name="IngameSidebarTheme_Red"    parent="IngameSidebarTheme_Black" />
    <style name="IngameSidebarTheme_Purple" parent="IngameSidebarTheme_Black" />
</resources>
