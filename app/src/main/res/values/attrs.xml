<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="NumberPicker">
        <attr name="value" format="integer" />
        <attr name="minValue" format="integer|float" />
        <attr name="maxValue" format="integer|float" />
        <attr name="step" format="integer|float" />
        <attr name="textSize" format="dimension" />
    </declare-styleable>
    <declare-styleable name="SeekBar">
        <attr name="sbMinValue" format="float" />
        <attr name="sbMaxValue" format="float" />
        <attr name="sbStep" format="float" />
        <attr name="sbValue" format="float" />
        <attr name="suffix" format="string" />
        <attr name="sbTextSize" format="dimension" />
        <attr name="colorSecondary" format="color" />
    </declare-styleable>

    <attr name="extraKeysButtonTextColor" format="reference" />
    <attr name="extraKeysButtonActiveTextColor" format="reference" />
    <attr name="extraKeysButtonBackgroundColor" format="reference" />
    <attr name="extraKeysButtonActiveBackgroundColor" format="reference" />

    <attr name="ingameSidebarBackground" format="color" />
    <attr name="ingameSidebarSurface" format="color" />
    <attr name="ingameSidebarSurfaceVariant" format="color" />
    <attr name="ingameSidebarOnSurface" format="color" />
    <attr name="ingameSidebarOnSurfaceVariant" format="color" />
    <attr name="ingameSidebarPrimary" format="color" />
    <attr name="ingameSidebarPrimaryContainer" format="color" />
    <attr name="ingameSidebarOutline" format="color" />

    <!-- Card background for ContentDialog, filled in by each dialog theme so the layout can stay
         theme-agnostic.  Setting it in the layout rather than from Java matters: a background
         applied programmatically after inflation overwrites the view's padding with the drawable's
         own content area, which silently ate the dialog's margins. -->
    <attr name="contentDialogBackground" format="reference" />
</resources>
